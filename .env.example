# Copy this file to .env and fill in real values locally.
# .env is gitignored. Never commit real secrets or tokens.
# Node servers load it via dotenv; Vite loads it for VITE_ client variables.

# Server (secret — choose a new value; the old PIN leaked in git history)
ADMIN_PIN=

# Server configuration
PORT=5000
ENVIRONMENT=prod
ALLOWED_ORIGIN=https://4helio.xyz
UPSTREAM_NOWPLAYING_URL=https://cli.4helio.xyz/api/nowplaying

# Client build (VITE_ values are embedded in the public bundle — not secrets)
VITE_API_URL=https://cli.4helio.xyz/api
VITE_SITE_URL=https://4helio.xyz/

# Vite dev server allowed hosts (comma-separated)
VITE_ALLOWED_HOSTS=vite-live.memblu.us.to

# Optional staging-server overrides (otherwise the values above are used)
DEV_PORT=50081
DEV_ENVIRONMENT=dev
